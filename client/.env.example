# Vite build-time variables (copy to client/.env for local overrides).

# Same-origin is used by default. Only set this if the server is on another host.
VITE_SERVER_URL=

# Path of the single Socket.IO server on Vercel.
VITE_SOCKET_PATH=/api/socket-io

# Optional TURN server for restrictive networks (comma-separated URLs allowed).
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
